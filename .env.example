OPENAI_API_KEY=your-api-key-here
# Required only for the HTTP service (uvicorn triageguard.api:app): a long random secret
# TRIAGEGUARD_API_TOKEN=
# Any OpenAI-compatible endpoint works. Example: Google Gemini (free tier, 15 requests/min)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# TRIAGEGUARD_MODEL=gemini-3.5-flash-lite
# Semantic search embeddings (default text-embedding-3-small for OpenAI; use this with Gemini; empty = keyword search only)
# TRIAGEGUARD_EMBED_MODEL=gemini-embedding-001
# Default model is gpt-4o-mini on OpenAI. Other endpoints: Azure, Ollama (http://localhost:11434/v1), ...
# TRIAGEGUARD_MIN_SCORE=3.0
# TRIAGEGUARD_MIN_SENSITIVE_SCORE=5.0
# TRIAGEGUARD_MIN_SIM=0.68
# TRIAGEGUARD_MIN_SENSITIVE_SIM=0.70
