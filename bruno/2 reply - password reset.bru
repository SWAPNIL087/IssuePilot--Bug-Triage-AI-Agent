meta {
  name: 2 reply - password reset
  type: http
  seq: 2
}

post {
  url: {{base}}/tickets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "id": "bruno-reply",
    "subject": "Password",
    "body": "I forgot my password, how do I reset it?"
  }
}

tests {
  test("answered from the docs with sources", function () {
    expect(res.status).to.equal(200);
    expect(res.body.decision).to.equal("REPLY");
    expect(res.body.sources.length).to.be.greaterThan(0);
  });
}
